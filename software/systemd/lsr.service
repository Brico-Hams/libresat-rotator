[Unit]
Description=LibreSat Rotator head (web UI :8080, rotctld :4533, tracker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lsr
Group=lsr
SupplementaryGroups=dialout
Environment=LSR_CONFIG=/etc/lsr/config.yaml
ExecStart=/opt/lsr/venv/bin/lsr run
Restart=always
RestartSec=3
# allowed to set the clock from GPS when there is no NTP in the field
AmbientCapabilities=CAP_SYS_TIME CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_SYS_TIME CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/home/lsr /etc/lsr

[Install]
WantedBy=multi-user.target
